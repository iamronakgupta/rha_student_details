## Required
# Your Google Apps Script deployment URL (must end with /exec)
VITE_STUDENT_API_BASE_URL=https://script.google.com/macros/s/AKfycbytd1p42fg5IWMPATHdgean0bI-vBRiQ4tCc_rnSpMBex0pZt_CcZh6q76tSVkWQktZ/exec

## Optional
# If your script requires an api_key query param
VITE_STUDENT_API_KEY=YOUR_SECRET_KEY

# Optional: Apps Script GET URL that returns image bytes for a Drive file id (see docs/GOOGLE_DRIVE_UPLOAD.md).
# Example: https://script.google.com/macros/s/XXXX/exec?action=drive_image
# The app appends &id=<fileId> (or ?id= if the URL has no query string).
# VITE_DRIVE_IMAGE_PROXY=

## GitHub Actions (recommended)
# In your GitHub repo:
# - Settings → Secrets and variables → Actions → Variables:
#   - VITE_STUDENT_API_BASE_URL
# - Settings → Secrets and variables → Actions → Secrets:
#   - VITE_STUDENT_API_KEY (optional)

